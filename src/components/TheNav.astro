---
import { links, socials } from '../constants';
import Link from './Link.astro';
import Logo from './Logo.astro';
---

<header class="w-full fixed top-0 left-0 right-0 z-100 bg-c-black/90">
    <nav
        class="flex gap-0.5 px-4 py-2 justify-between items-start max-w-6xl mx-auto md:px-6"
    >
        <div>
            <Logo />
        </div>
        <div class="flex gap-8 md:gap-12 lg:gap-32">
            <ul class="text-sm">
                {
                    links.map(({ label, to }) => (
                        <li>
                            <Link to={to} label={label} />
                        </li>
                    ))
                }
            </ul>
            <ul class="md:flex gap-2 text-sm text-white space-y-3">
                {
                    socials.map(({ icon: Icon, to, target }) => (
                        <li class="hover:text-highlight transition-colors duration-400">
                            <a href={to} target={target}>
                                <Icon class="size-6" />
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>
    </nav>
</header>
