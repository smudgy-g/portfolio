---
interface Props {
    to: string;
    label: string;
}
const { to, label } = Astro.props;
---

<a href={to} class="group relative inline-block">
    <span>{label}</span>
    <span
        class="absolute bottom-0 left-0 h-0.5 w-0 bg-c-white transition-all duration-300 group-hover:w-full"
    ></span>
</a>
