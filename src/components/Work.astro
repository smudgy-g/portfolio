---
import { getCollection, type CollectionEntry } from 'astro:content'

const jobs: CollectionEntry<'jobs'>[] = await getCollection('jobs')
---

<div>
    <h3>Work Experience</h3>
    <div class="grid gap-10 mt-6">
        {jobs.map(({ data, id }) => (
            <div class="flex flex-col md:flex-row gap-2 md:gap-8">
                <div class="shrink-0 min-w-28">
                    <span class="text-gray-600 leading-8">{data.date}</span>
                </div>
                <div class="space-y-1">
                    <p class="text-base/8 text-balance">
                        <span class="font-medium">{data.position} </span>
                        at
                        <span class="">{id}</span>
                    </p>
                    <p class="">{data.summary}</p>
    
                    <ul class="list-disc ml-8 mt-4">
                        {data.responsibilities?.map((item: string) => (
                            <li class="">{item}</li>
                        ))}
                    </ul>
    
                </div>
            </div>
        ))}
    </div>
</div>
