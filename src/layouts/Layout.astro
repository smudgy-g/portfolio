---
import TheFooter from '../components/TheFooter.astro';
import TheNav from '../components/TheNav.astro';
import '../styles/global.css';

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <!-- TODO: Change favicon -->
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />

        <title>adamgriff.dev</title>
    </head>
    <body>
        <TheNav />

        <div>
            <div slot="head" class="pt-24">
                <div class="mx-auto max-w-4xl px-3 md:px-6">
                    <h1 class="font-semibold">{title}</h1>
                </div>
            </div>
            <slot name="head" />
        </div>
    </body>
    <main class="mb-20 max-w-6xl mx-auto">
        <slot />
    </main>
</html>
<TheFooter />
