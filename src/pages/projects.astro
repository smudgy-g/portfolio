---
import Layout from '../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

const sideProjects: CollectionEntry<'sideProjects'>[] =
    await getCollection('sideProjects');
---

<Layout title="projects">
    <div class="py-8 md:py-12">
        <div class="px-24">
            <div class="mt-6 space-y-3 text-xs max-w-sm md:max-w-lg">
                <div class="grid gap-10 mt-6">
                    {
                        sideProjects.map(({ data, id }) => (
                            <div class="flex flex-col md:flex-row gap-2 md:gap-8">
                                <div class="shrink-0 min-w-28">
                                    <span class="text-gray-600 leading-8">
                                        {data.date}
                                    </span>
                                </div>
                                <div class="space-y-2">
                                    <p class="font-medium text-base/8 text-balance">
                                        {id}
                                    </p>
                                    <ul class="flex gap-2">
                                        {data.technologies.map((item) => (
                                            <li class="italic">{item}</li>
                                        ))}
                                    </ul>

                                    <p class="">{data.description}</p>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</Layout>
