---
import Layout from '../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

const books: CollectionEntry<'books'>[] = await getCollection('books');
---

<Layout title="books">
    <div class="py-8 md:py-12">
        <div
            class="px-4 sm:px-24 md:px-6 max-w-4xl mx-auto md:max-w-3xl md:pr-24"
        >
            <div class="mt-6 space-y-3 lg:mx-auto">
                <div class="grid gap-8 grid-cols-2 md:grid-cols-3 mt-6 text-sm">
                    {
                        books.map(({ data }) => (
                            <div class="flex flex-col space-y-2">
                                <div>
                                    <img
                                        src={`https://covers.openlibrary.org/b/isbn/${data.isbn}-M.jpg`}
                                        alt={data.title}
                                        class="object-cover h-40 w-auto"
                                    />
                                </div>
                                <div>
                                    <p class="font-medium text-balance">
                                        {data.title}{' '}
                                        <span class="font-light">
                                            ({data.published_date})
                                        </span>
                                    </p>
                                    <p class="text-stone-400">{data.author}</p>
                                </div>

                                <p class="text-xs font-light">{data.isbn}</p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</Layout>
