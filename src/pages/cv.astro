---
import Layout from '../layouts/Layout.astro';
import Work from '../components/Work.astro';
import Projects from '../components/Projects.astro';
import SideProjects from '../components/SideProjects.astro';
---

<Layout title="Experience & Projects">
	<div class="relative bg-background space-y-3 border-2 rounded-xl p-4 pt-12 border-primary before:content-[''] before:rounded-t-xl before:outline-2 before:outline-primary before:h-8 before:bg-secondary before:absolute before:-top-0 before:left-0 before:right-0">
		<section>
			<Work />
		</section>
		<section class="my-12">
			<Projects />
		</section>
		<section class="my-12">
			<SideProjects />
		</section>
	</div>
</Layout>
